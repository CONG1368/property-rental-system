# ====== 物业租赁综合管理系统 - 环境配置 ======
# 复制此文件为 .env 并根据需要修改

# 应用端口
PORT=3001

# 数据库方言: sqlite (默认，零配置) 或 mysql (需要安装 MySQL 8.0)
DB_DIALECT=sqlite

# SQLite 配置 (DB_DIALECT=sqlite 时生效)
# 数据库文件路径（相对于 backend 目录）
# DB_STORAGE=./data/database.sqlite

# MySQL 配置 (DB_DIALECT=mysql 时生效)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=property_rental
DB_USER=root
DB_PASSWORD=

# Redis 配置（可选）
# 设为 false 禁用 Redis，系统可正常运行
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT 密钥（生产环境请改为复杂随机字符串）
JWT_SECRET=property-rental-jwt-secret-key-2026

# 环境模式
NODE_ENV=development

# ====== 外部服务（均可留空：留空时自动走 Mock，写日志到 backend/logs/，不影响业务） ======

# --- 短信（零依赖实现，无需安装 SDK）---
# SMS_PROVIDER: mock（默认） | aliyun | tencent
SMS_PROVIDER=mock
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=物业租赁管理系统
# 腾讯云必填：短信应用 SdkAppId（1400xxxxxxx）；可选 SMS_REGION（默认 ap-guangzhou）
# SMS_APP_ID=
# SMS_REGION=ap-guangzhou
# 模板编号（阿里云为 SMS_xxx，腾讯云为纯数字模板 ID）
# SMS_TEMPLATE_DUNNING=
# SMS_TEMPLATE_BILL=
# SMS_TIMEOUT_MS=10000

# --- 电子签章（e签宝开放平台 v3，零依赖实现）---
# ESIGN_PROVIDER: mock（默认） | esign
ESIGN_PROVIDER=mock
# ESIGN_APP_ID=
# ESIGN_APP_SECRET=
# 正式环境 https://openapi.esign.cn ；沙箱 https://smlopenapi.esign.cn
# ESIGN_SERVER_URL=https://openapi.esign.cn
# 默认待签署文件 ID（也可写入合同 billingConfig.esignFileId）
# ESIGN_FILE_ID=
# ESIGN_NOTIFY_URL=
# ESIGN_TIMEOUT_MS=15000

# --- 邮件（内置零依赖 SMTP 客户端，无需 nodemailer）---
# 必填：HOST / USER / PASS（缺任一即降级 Mock）
# SMTP_HOST=smtp.example.com
# 465=隐式 TLS（默认），587/25=明文 + STARTTLS 自动升级
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# 省略时取 SMTP_USER，支持「显示名 <地址>」写法
# SMTP_FROM=物业租赁管理系统 <noreply@example.com>
# 显式指定是否隐式 TLS（不填按端口推断）
# SMTP_SECURE=true
# SMTP_TIMEOUT=15000
# 自签名证书的内网邮件服务器可设为 true 跳过证书校验
# SMTP_TLS_INSECURE=false

# --- 微信公众号模板消息（零依赖实现）---
# 三项必填，缺任一即降级 Mock；模板需含 first / keyword1 / remark 三个占位字段
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_TEMPLATE_ID=
# WECHAT_API_TIMEOUT=10000
# 仅联调用（默认官方域名 https://api.weixin.qq.com）
# WECHAT_API_BASE=
